{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(mise run:*)",
      "Bash(mise tasks:*)",
      "Bash(mise exec -- pnpm lint:*)",
      "Bash(mise exec -- pnpm test:*)",
      "Bash(mise exec -- pnpm typecheck:*)",
      "Bash(mise exec -- cargo test:*)",
      "Bash(mise exec -- cargo check:*)",
      "Bash(mise exec -- cargo clippy:*)",
      "Bash(mise exec -- cargo fmt:*)",
      "Bash(mise exec -- uv run pytest:*)",
      "Bash(mise exec -- uv run ruff:*)",
      "Bash(mise exec -- uv run opendopa:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env.local)",
      "Edit(./.env.local)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
