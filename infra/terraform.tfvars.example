# コピーして terraform.tfvars を作る(terraform.tfvars はコミットしない)
env_name = "dev"
# subscription_id = "00000000-0000-0000-0000-000000000000"
# Container Registry の名前が他と衝突したときに足す
# name_suffix = "team"

# 管理者パスワードは tfvars に書かず、環境変数で渡す(16 文字以上)
#   export TF_VAR_postgres_admin_password='...'
# 音声は pipeline のバッチで作る。web には、クレジットを出すために渡す
# tts_provider = "voicevox"
# tts_credit   = "VOICEVOX:ずんだもん"
# 内部 HTTP の共有トークン(16 文字以上)。recsys 用の読み取り専用 DB 接続は、ロールを作ったあとに渡す
#   export TF_VAR_internal_token='...'
#   export TF_VAR_recsys_database_url='postgres://opendopa_recsys:...@<host>:5432/opendopa?sslmode=require'

# 最小構成で始めるときは、Blob と配信を作らない(enable_cdn は enable_storage が true のときだけ使える)
# enable_cdn     = false   # Front Door を作らない。MEDIA_BASE_URL は Blob の URL になる
# enable_storage = false   # Blob も作らない(pipeline の publish 先と配信がなくなる)
