# OpenDopa の環境変数(設計書 §12.3、ADR-0012 A18)
# `mise run setup` で .env.local にコピーされる。.env.local は git 管理外。
# ローカルで使う値は、そのまま動く値にしてある。Azure のキーなどは空欄。

# ---- DB(docker-compose で起動する PostgreSQL。`mise run db-up`) ----
DATABASE_URL=postgres://opendopa:opendopa@localhost:5432/opendopa?sslmode=disable
# recsys 用の読み取り専用ロール(db/init/01-roles.sql で作成。パスワードもそこと合わせる)
RECSYS_DATABASE_URL=postgres://opendopa_recsys:opendopa_recsys@localhost:5432/opendopa?sslmode=disable

# ---- web → recsys の内部 HTTP ----
RECSYS_URL=http://localhost:8080
INTERNAL_TOKEN=local-dev-token
# recsys が待ち受けるポート(Container Apps でも使う)
PORT=8080

# ---- 配信 ----
MEDIA_BASE_URL=http://localhost:3000/media

# ---- 差し替え点(§0.4)。Azure なしで動く既定値 ----
EMBED_PROVIDER=local
EMBED_DIM=1024
TTS_PROVIDER=none
LLM_PROVIDER=none
DECIDER_PROVIDER=rules
# DECIDER_PROVIDER=strands_azure のとき(外部 URL。terraform output decider_url。Bearer トークンで認証)
STRANDS_DECIDER_URL=
STRANDS_DECIDER_TOKEN=

# ---- Azure OpenAI ----
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_EMBED_DEPLOYMENT=
AZURE_OPENAI_CHAT_DEPLOYMENT=

# ---- Azure AI Speech ----
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ---- Blob(pipeline の publish) ----
STORAGE_CONNECTION_STRING=

# ---- 監視 ----
APPLICATIONINSIGHTS_CONNECTION_STRING=
