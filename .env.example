# OpenDopa の環境変数(設計書 §12.3、ADR-0012 A18)
# `mise run setup` で .env.local にコピーされる。.env.local は git 管理外。
# ローカルで使う値は、そのまま動く値にしてある。Azure のキーなどは空欄。

# ---- DB(docker-compose で起動する PostgreSQL。`mise run db-up`) ----
DATABASE_URL=postgres://opendopa:opendopa@localhost:5432/opendopa?sslmode=disable
# recsys 用の読み取り専用ロール(db/init/01-roles.sql で作成。パスワードもそこと合わせる)
RECSYS_DATABASE_URL=postgres://opendopa_recsys:opendopa_recsys@localhost:5432/opendopa?sslmode=disable

# ---- web → recsys の内部 HTTP ----
RECSYS_URL=http://localhost:8080
INTERNAL_TOKEN=local-dev-token
# recsys が待ち受けるポート(Container Apps でも使う)
PORT=8080

# ---- 配信 ----
MEDIA_BASE_URL=http://localhost:3000/media

# ---- 差し替え点(§0.4)。埋め込みは Azure OpenAI(Azure なしで試すときは local) ----
EMBED_PROVIDER=azure
EMBED_DIM=1024
TTS_PROVIDER=none
LLM_PROVIDER=none
DECIDER_PROVIDER=rules
# DECIDER_PROVIDER=strands_azure のとき(外部 URL。terraform output decider_url。Bearer トークンで認証)
STRANDS_DECIDER_URL=
STRANDS_DECIDER_TOKEN=
# DECIDER_PROVIDER=strands_local のとき(手元の PC で動かす。先に `uv sync --extra decider`。
# 初回は Hugging Face Hub から重み(約 4.6 GB)を落とす。評価に合格するまで既定は rules のまま)
# STRANDS_LOCAL_MODEL=StrandsAgents/strands-decider-2B-hobson-v19
# STRANDS_LOCAL_DEVICE=   # cuda / mps / cpu。空なら使えるものを自動で選ぶ

# ---- Azure OpenAI(Terraform の `enable_openai`(既定 true)で作る。出力 azure_openai_* の値を入れる) ----
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_EMBED_DEPLOYMENT=
# チャットのデプロイは LLM_PROVIDER=none のあいだは不要
AZURE_OPENAI_CHAT_DEPLOYMENT=

# ---- VOICEVOX(TTS_PROVIDER=voicevox) ----
VOICEVOX_URL=http://localhost:50021
# スタイルID(3 = ずんだもん ノーマル)。変えたら TTS_CREDIT も合わせる
VOICEVOX_SPEAKER=3
VOICEVOX_SPEED=1.0
# フッターのクレジット(web が読む)。未設定なら「VOICEVOX:ずんだもん」
TTS_CREDIT=VOICEVOX:ずんだもん

# ---- BGM(任意。フィード全体で 1 曲をループ。web が読む) ----
# ライセンスを確認した音源だけを置く。両方そろったときだけ鳴り、BGM_CREDIT がフッターに出る。
# BGM_FILE は MEDIA_BASE_URL からの相対パス(または http(s) の URL)
BGM_FILE=
BGM_CREDIT=
# 0〜1(読み上げが聞き取れる小さめの既定 0.15)
BGM_VOLUME=

# ---- Blob(pipeline の publish) ----
STORAGE_CONNECTION_STRING=
# 元 CSV の読み先。local(既定。datasets/*.yaml の files)/ blob(Blob のコンテナ raw の <dataset_id>/ 配下をすべて読む。ジョブで使う)
RAW_SOURCE=local
RAW_BLOB_CONTAINER=raw

# ---- 監視 ----
# 設定したときだけ web が Application Insights に送る(空ならローカルでは何も送らない。terraform output application_insights_connection_string)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ---- Terraform 用(infra/。`mise run infra-plan` などが読む。値は 16 文字以上) ----
# 生成例: openssl rand -base64 24
TF_VAR_postgres_admin_password=
TF_VAR_internal_token=
